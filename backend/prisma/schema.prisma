// Esquema de Prisma para el MVP hotelero.
// Los modelos se mapean a snake_case en la base de datos para que
// el SQL manual de la migración de no-sobreventa calce con los nombres reales.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// R25: libre → ocupada (check-in) → en_limpieza (check-out) → libre (lista).
// R26: fuera_servicio (mantenimiento) no se ofrece en la disponibilidad.
enum EstadoHabitacion {
  libre
  ocupada
  en_limpieza
  fuera_servicio
}

enum EstadoReserva {
  confirmada
  activa
  cerrada
  cancelada
  no_show
}

// plataforma: equipo de Lazaro (Consola Lazaro), no pertenece a ningún hotel.
// admin: gerencia de un hotel. recepcionista: operación diaria de un hotel.
enum RolUsuario {
  plataforma
  admin
  recepcionista
}

// Cada hotel cliente de la plataforma (multi-tenant): sus datos, su marca y
// sus políticas. Todo lo operativo cuelga de un hotel y nunca se cruza con otro.
model Hotel {
  id            String            @id @default(uuid())
  // Identificador para la URL de su login con marca (?hotel=sol-caribe).
  slug          String            @unique
  nombre        String
  ciudad        String?
  nit           String?
  telefono      String?
  // Un hotel suspendido (p. ej. por falta de pago) no puede entrar.
  activo        Boolean           @default(true)
  // Marca del hotel.
  eslogan       String?
  // Imagen PNG/JPG/WEBP como data URL (sin SVG: puede llevar scripts).
  logo          String?
  colorPrimario String            @default("#0f1b2d") @map("color_primario")
  colorAcento   String            @default("#c9a227") @map("color_acento")
  fuenteTitulos String            @default("Playfair Display") @map("fuente_titulos")
  fuenteTexto   String            @default("Inter") @map("fuente_texto")
  // Políticas propias; lo que no esté aquí toma el valor por defecto
  // (hotel/politicas.ts).
  politicas     Json              @default("{}")
  createdAt     DateTime          @default(now()) @map("created_at")
  usuarios      Usuario[]
  tipos         TipoHabitacion[]
  habitaciones  Habitacion[]
  huespedes     Huesped[]
  reservas      Reserva[]
  temporadas    Temporada[]
  productos     ProductoConsumo[]

  @@map("hotel")
}

// R22: catálogo de consumos del hotel (minibar, lavandería, restaurante...)
// con su precio. Un producto no se borra (los cargos lo referencian): se
// desactiva y deja de ofrecerse.
model ProductoConsumo {
  id        String         @id @default(uuid())
  hotelId   String         @map("hotel_id")
  hotel     Hotel          @relation(fields: [hotelId], references: [id])
  nombre    String
  categoria CategoriaCargo
  // Valor final por unidad, impuestos incluidos (⚖️ validar con contador).
  precio    Decimal        @db.Decimal(10, 2)
  activo    Boolean        @default(true)
  createdAt DateTime       @default(now()) @map("created_at")
  cargos    Cargo[]

  @@unique([hotelId, nombre])
  @@map("producto_consumo")
}

enum TipoTemporada {
  alta
  media
}

// R13–R15: rangos de temporada que el hotel define y que se repiten cada año.
// Mes y día como número (15 de diciembre → 1215); si "desde" es mayor que
// "hasta", el rango cruza el fin de año.
model Temporada {
  id        String        @id @default(uuid())
  hotelId   String        @map("hotel_id")
  hotel     Hotel         @relation(fields: [hotelId], references: [id])
  nombre    String
  tipo      TipoTemporada
  desde     Int
  hasta     Int
  activa    Boolean       @default(true)
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([hotelId])
  @@map("temporada")
}

// Personas que usan el sistema (no confundir con los huéspedes). El correo es
// único en toda la plataforma: con él se sabe a qué hotel pertenece cada quien.
model Usuario {
  id             String          @id @default(uuid())
  // null solo para el rol plataforma.
  hotelId        String?         @map("hotel_id")
  hotel          Hotel?          @relation(fields: [hotelId], references: [id])
  nombre         String
  email          String          @unique
  contrasenaHash String          @map("contrasena_hash")
  rol            RolUsuario
  // Un usuario desactivado no puede entrar; se conserva para el historial.
  activo         Boolean         @default(true)
  createdAt      DateTime        @default(now()) @map("created_at")
  eventos        EventoReserva[]
  cargos         Cargo[]

  @@map("usuario")
}

enum TipoEventoReserva {
  creada
  check_in
  check_out
  cancelada
  no_show
  cargo_agregado
  cargo_anulado
}

enum CategoriaCargo {
  minibar
  lavanderia
  restaurante
  late_checkout
  otro
}

enum MotivoViaje {
  turismo
  negocios
  salud
  eventos
  otro
}

enum MedioPago {
  efectivo
  tarjeta
  transferencia
}

// Folio (R20–R23): consumos cargados a la habitación durante la estadía.
// Un cargo no se borra: se anula, y la anulación queda en la auditoría.
model Cargo {
  id              String           @id @default(uuid())
  reservaId       String           @map("reserva_id")
  reserva         Reserva          @relation(fields: [reservaId], references: [id])
  // Producto del catálogo, si salió de él. Concepto, categoría y valor se
  // copian al cargar: cambiar el catálogo no altera los cargos ya hechos.
  productoId      String?          @map("producto_id")
  producto        ProductoConsumo? @relation(fields: [productoId], references: [id])
  categoria       CategoriaCargo
  concepto        String
  cantidad        Int
  // ⚖️ Valor final tal como lo cobra el punto de venta (impuestos incluidos).
  valorUnitario   Decimal          @map("valor_unitario") @db.Decimal(10, 2)
  total           Decimal          @db.Decimal(10, 2)
  fecha           DateTime         @default(now())
  usuarioId       String           @map("usuario_id")
  usuario         Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  anulado         Boolean          @default(false)
  motivoAnulacion String?          @map("motivo_anulacion")

  @@index([reservaId])
  @@map("cargo")
}

// Auditoría (R34): qué le pasó a cada reserva, quién lo hizo y cuándo.
// Se escribe en la misma transacción que el cambio de estado.
model EventoReserva {
  id        String            @id @default(uuid())
  reservaId String            @map("reserva_id")
  reserva   Reserva           @relation(fields: [reservaId], references: [id])
  tipo      TipoEventoReserva
  // null = acción automática del sistema (p. ej. detección de no-shows).
  // Restrict: un usuario con acciones registradas no se puede borrar (se
  // desactiva), para que la auditoría nunca pierda quién hizo qué.
  usuarioId String?           @map("usuario_id")
  usuario   Usuario?          @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  fecha     DateTime          @default(now())
  detalle   String?

  @@index([reservaId])
  @@map("evento_reserva")
}

// R12: el precio y la capacidad se definen por tipo de habitación; cambiar la
// tarifa de "todas las dobles" es una sola edición.
model TipoHabitacion {
  id                    String       @id @default(uuid())
  hotelId               String       @map("hotel_id")
  hotel                 Hotel        @relation(fields: [hotelId], references: [id])
  codigo                String
  nombre                String
  // Tarifa por noche en temporada baja; las otras temporadas la multiplican.
  tarifaBase            Decimal      @map("tarifa_base") @db.Decimal(10, 2)
  capacidadIncluida     Int          @map("capacidad_incluida")
  capacidadMaxima       Int          @map("capacidad_maxima")
  cargoPersonaAdicional Decimal      @map("cargo_persona_adicional") @db.Decimal(10, 2)
  habitaciones          Habitacion[]

  @@unique([hotelId, codigo])
  @@map("tipo_habitacion")
}

model Habitacion {
  id               String           @id @default(uuid())
  hotelId          String           @map("hotel_id")
  hotel            Hotel            @relation(fields: [hotelId], references: [id])
  numero           String
  tipoHabitacionId String           @map("tipo_habitacion_id")
  tipoHabitacion   TipoHabitacion   @relation(fields: [tipoHabitacionId], references: [id])
  estado           EstadoHabitacion @default(libre)
  reservas         Reserva[]

  // Dos hoteles pueden tener cada uno su habitación 101.
  @@unique([hotelId, numero])
  @@map("habitacion")
}

enum TipoDocumento {
  CC // cédula de ciudadanía
  CE // cédula de extranjería
  PASAPORTE
  TI // tarjeta de identidad (menores)
  PPT // permiso por protección temporal
}

// Un huésped se identifica por su documento dentro de cada hotel: si vuelve,
// se reutiliza su registro y se conserva su historial de estadías. Los hoteles
// no comparten clientes entre sí.
model Huesped {
  id            String        @id @default(uuid())
  hotelId       String        @map("hotel_id")
  hotel         Hotel         @relation(fields: [hotelId], references: [id])
  nombre        String
  tipoDocumento TipoDocumento @default(CC) @map("tipo_documento")
  documento     String
  telefono      String?
  // R19: código ISO 3166-1 alfa-2 (CO, VE, US...). Se registra en el check-in.
  nacionalidad  String?
  reservas      Reserva[]

  @@unique([hotelId, tipoDocumento, documento])
  @@map("huesped")
}

model Reserva {
  id                       String          @id @default(uuid())
  // Se repite el hotel de la habitación para filtrar directo por él.
  hotelId                  String          @map("hotel_id")
  hotel                    Hotel           @relation(fields: [hotelId], references: [id])
  habitacionId             String          @map("habitacion_id")
  habitacion               Habitacion      @relation(fields: [habitacionId], references: [id])
  huespedId                String          @map("huesped_id")
  huesped                  Huesped         @relation(fields: [huespedId], references: [id])
  fechaEntrada             DateTime        @map("fecha_entrada") @db.Date
  fechaSalida              DateTime        @map("fecha_salida") @db.Date
  estado                   EstadoReserva   @default(confirmada)
  numeroHuespedes          Int             @default(1) @map("numero_huespedes")
  // Precio total pactado al confirmar (R5): no cambia aunque el hotel
  // modifique sus tarifas después. Incluye adicionales e IVA.
  valorAlojamiento         Decimal         @map("valor_alojamiento") @db.Decimal(10, 2)
  // Desglose congelado noche por noche (ver tarifas/motor-tarificacion.ts).
  // null en reservas anteriores al motor de tarifas.
  desglose                 Json?
  // R5/R9: la política de cancelación del hotel al reservar queda pactada,
  // igual que el precio: si el hotel la cambia, esta reserva no se afecta.
  // null en reservas anteriores (usan la política vigente).
  cancelacionGratuitaHasta DateTime?       @map("cancelacion_gratuita_hasta")
  nochesPenalidad          Int?            @map("noches_penalidad")
  // Monto liquidado al terminar: el alojamiento en el check-out, o la
  // penalidad en una cancelación tardía / no-show (0 si no aplica).
  total                    Decimal?        @db.Decimal(10, 2)
  // Se registra al liquidar el folio en el check-out (R23).
  medioPago                MedioPago?      @map("medio_pago")
  // R19: datos del registro hotelero de esta estadía, tomados en el check-in.
  procedencia              String?
  motivoViaje              MotivoViaje?    @map("motivo_viaje")
  createdAt                DateTime        @default(now()) @map("created_at")
  eventos                  EventoReserva[]
  cargos                   Cargo[]

  @@index([hotelId, estado])
  @@map("reserva")
}
