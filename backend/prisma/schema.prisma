// Esquema de Prisma para el MVP hotelero.
// Los modelos se mapean a snake_case en la base de datos para que
// el SQL manual de la migración de no-sobreventa calce con los nombres reales.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// R25: libre → ocupada (check-in) → en_limpieza (check-out) → libre (lista).
// R26: fuera_servicio (mantenimiento) no se ofrece en la disponibilidad.
enum EstadoHabitacion {
  libre
  ocupada
  en_limpieza
  fuera_servicio
}

enum EstadoReserva {
  confirmada
  activa
  cerrada
  cancelada
  no_show
}

// plataforma: equipo de Lazaro (Consola Lazaro), no pertenece a ningún hotel.
// admin: gerencia de un hotel. recepcionista: operación diaria de un hotel.
// housekeeping (B-4): camarera; solo ve las habitaciones y su limpieza.
enum RolUsuario {
  plataforma
  admin
  recepcionista
  housekeeping
}

// Cada hotel cliente de la plataforma (multi-tenant): sus datos, su marca y
// sus políticas. Todo lo operativo cuelga de un hotel y nunca se cruza con otro.
model Hotel {
  id                 String                 @id @default(uuid())
  // Identificador para la URL de su login con marca (?hotel=sol-caribe).
  slug               String                 @unique
  nombre             String
  ciudad             String?
  nit                String?
  telefono           String?
  // Un hotel suspendido (p. ej. por falta de pago) no puede entrar.
  activo             Boolean                @default(true)
  // Marca del hotel.
  eslogan            String?
  // Imagen PNG/JPG/WEBP como data URL (sin SVG: puede llevar scripts).
  logo               String?
  colorPrimario      String                 @default("#0f1b2d") @map("color_primario")
  colorAcento        String                 @default("#c9a227") @map("color_acento")
  fuenteTitulos      String                 @default("Playfair Display") @map("fuente_titulos")
  fuenteTexto        String                 @default("Inter") @map("fuente_texto")
  // Políticas propias; lo que no esté aquí toma el valor por defecto
  // (hotel/politicas.ts).
  politicas          Json                   @default("{}")
  // Dato de la TRA (MinCIT): hotel, hostal, apartahotel...
  tipoAlojamiento    String                 @default("Hotel") @map("tipo_alojamiento")
  createdAt          DateTime               @default(now()) @map("created_at")
  usuarios           Usuario[]
  tipos              TipoHabitacion[]
  habitaciones       Habitacion[]
  huespedes          Huesped[]
  reservas           Reserva[]
  temporadas         Temporada[]
  categoriasServicio CategoriaServicio[]
  servicios          Servicio[]
  ocupantes          Ocupante[]
  politicasDatos     PoliticaDatos[]
  pagos              Pago[]
  recursosServicio   RecursoServicio[]
  citas              CitaServicio[]
  salidas            SalidaExperiencia[]
  cupos              CupoExperiencia[]
  turnos             Turno[]
  intentosPago       IntentoPago[]
  pasarela           ConfiguracionPasarela?
  tareasLimpieza     TareaLimpieza[]
  incidencias        Incidencia[]

  @@map("hotel")
}

// S-1 (R22): categoría del catálogo que crea cada hotel ("Masajes", "Tours").
// La clasificación es la contable fija (CategoriaCargo), la que usan los
// reportes. No se borra: se desactiva.
model CategoriaServicio {
  id            String               @id @default(uuid())
  hotelId       String               @map("hotel_id")
  hotel         Hotel                @relation(fields: [hotelId], references: [id])
  nombre        String
  orden         Int                  @default(0)
  // Nombre de un icono de la interfaz (lucide), p. ej. "sparkles".
  icono         String?
  clasificacion CategoriaCargo
  activa        Boolean              @default(true)
  createdAt     DateTime             @default(now()) @map("created_at")
  atributos     DefinicionAtributo[]
  servicios     Servicio[]

  @@unique([hotelId, nombre])
  @@map("categoria_servicio")
}

enum TipoAtributo {
  texto
  numero
  si_no
  lista
}

// S-1 (R54): campo propio que el hotel define para los servicios de una
// categoría ("Nivel de dificultad"). Solo se muestra y se filtra: no entra en
// ningún cálculo. La clave no cambia (es la del JSON de cada servicio).
model DefinicionAtributo {
  id          String            @id @default(uuid())
  categoriaId String            @map("categoria_id")
  categoria   CategoriaServicio @relation(fields: [categoriaId], references: [id])
  clave       String
  etiqueta    String
  tipo        TipoAtributo
  // Solo para el tipo lista.
  opciones    String[]          @default([])
  obligatorio Boolean           @default(false)
  orden       Int               @default(0)

  @@unique([categoriaId, clave])
  @@map("definicion_atributo")
}

enum TipoServicio {
  consumo
  cita
  experiencia
}

enum ModoPrecio {
  fijo
  por_persona
  por_edad
}

// S-1 (R22): servicio del catálogo del hotel (minibar, lavandería, spa,
// tours...). No se borra (los cargos lo referencian): se desactiva y deja de
// ofrecerse. Antes se llamaba ProductoConsumo (mismos ids).
model Servicio {
  id               String              @id @default(uuid())
  hotelId          String              @map("hotel_id")
  hotel            Hotel               @relation(fields: [hotelId], references: [id])
  // Identificador estable para la carga masiva (plan 09).
  codigo           String
  nombre           String
  descripcion      String?
  categoriaId      String              @map("categoria_id")
  categoria        CategoriaServicio   @relation(fields: [categoriaId], references: [id])
  tipo             TipoServicio        @default(consumo)
  modoPrecio       ModoPrecio          @default(fijo) @map("modo_precio")
  // Valor final (adulto o único), impuestos incluidos (⚖️ validar con contador).
  precio           Decimal             @db.Decimal(10, 2)
  // R55: por niño con cargo, si el modo es por edad (los gratis no pagan).
  precioNino       Decimal?            @map("precio_nino") @db.Decimal(10, 2)
  // Cita y experiencia.
  duracionMinutos  Int?                @map("duracion_minutos")
  // Experiencia: personas por salida (la agenda llega en S-2).
  cuposPorSalida   Int?                @map("cupos_por_salida")
  // { dias: [1..7] (1 = lunes), desde: "08:00", hasta: "18:00" }.
  disponibilidad   Json?
  // Hasta 3 imágenes como data URL, con los límites del logo (hotel/marca.ts).
  fotos            String[]            @default([])
  // R54: valores de los atributos propios de su categoría.
  atributos        Json                @default("{}")
  visibleRecepcion Boolean             @default(true) @map("visible_recepcion")
  activo           Boolean             @default(true)
  createdAt        DateTime            @default(now()) @map("created_at")
  cargos           Cargo[]
  // S-2: quién presta las citas, las citas y las salidas de las experiencias.
  recursos         RecursoDeServicio[]
  citas            CitaServicio[]
  salidas          SalidaExperiencia[]

  @@unique([hotelId, codigo])
  @@unique([hotelId, nombre])
  @@map("servicio")
}

enum TipoTemporada {
  alta
  media
}

// R13–R15: rangos de temporada que el hotel define y que se repiten cada año.
// Mes y día como número (15 de diciembre → 1215); si "desde" es mayor que
// "hasta", el rango cruza el fin de año.
model Temporada {
  id        String        @id @default(uuid())
  hotelId   String        @map("hotel_id")
  hotel     Hotel         @relation(fields: [hotelId], references: [id])
  nombre    String
  tipo      TipoTemporada
  desde     Int
  hasta     Int
  activa    Boolean       @default(true)
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([hotelId])
  @@map("temporada")
}

// Personas que usan el sistema (no confundir con los huéspedes). El correo es
// único en toda la plataforma: con él se sabe a qué hotel pertenece cada quien.
model Usuario {
  id                        String            @id @default(uuid())
  // null solo para el rol plataforma.
  hotelId                   String?           @map("hotel_id")
  hotel                     Hotel?            @relation(fields: [hotelId], references: [id])
  nombre                    String
  email                     String            @unique
  contrasenaHash            String            @map("contrasena_hash")
  rol                       RolUsuario
  // Un usuario desactivado no puede entrar; se conserva para el historial.
  activo                    Boolean           @default(true)
  createdAt                 DateTime          @default(now()) @map("created_at")
  eventos                   EventoReserva[]
  cargos                    Cargo[]
  autorizacionesVerificadas Ocupante[]
  aceptacionesRegistradas   AceptacionDatos[]
  pagosRegistrados          Pago[]            @relation("PagoRegistradoPor")
  pagosAnulados             Pago[]            @relation("PagoAnuladoPor")
  citasAgendadas            CitaServicio[]
  cuposTomados              CupoExperiencia[]
  turnos                    Turno[]
  intentosPago              IntentoPago[]
  tareasLimpieza            TareaLimpieza[]
  incidenciasReportadas     Incidencia[]      @relation("IncidenciaReportadaPor")
  incidenciasResueltas      Incidencia[]      @relation("IncidenciaResueltaPor")

  @@map("usuario")
}

enum TipoEventoReserva {
  creada
  check_in
  check_out
  cancelada
  no_show
  cargo_agregado
  cargo_anulado
  // A-3: la edad registrada en el check-in no es la declarada al reservar.
  diferencia_edad
  // A-1: movimientos del libro de pagos.
  pago_registrado
  pago_anulado
  // A-5: cambio de fechas, habitación o personas (antes y después en `datos`).
  modificada
  // B-2: se generó un link de pago, o llegó un pago en línea que no cuadra.
  link_de_pago
  alerta_pago_en_linea
}

enum CategoriaCargo {
  minibar
  lavanderia
  restaurante
  late_checkout
  spa
  experiencia
  otro
}

enum MotivoViaje {
  turismo
  negocios
  salud
  eventos
  otro
}

enum MedioPago {
  efectivo
  tarjeta
  transferencia
  pasarela // pagos en línea (plan 14)
  otro
}

// A-1: abono = pago durante la estadía o del saldo; anticipo = antes de llegar
// (plan 06); reembolso = dinero que el hotel devuelve.
enum TipoPago {
  abono
  anticipo
  reembolso
}

// Folio (R20–R23): consumos cargados a la habitación durante la estadía.
// Un cargo no se borra: se anula, y la anulación queda en la auditoría.
model Cargo {
  id              String           @id @default(uuid())
  reservaId       String           @map("reserva_id")
  reserva         Reserva          @relation(fields: [reservaId], references: [id])
  // Servicio del catálogo, si salió de él. Concepto, clasificación y valor se
  // copian al cargar: cambiar el catálogo no altera los cargos ya hechos.
  servicioId      String?          @map("servicio_id")
  servicio        Servicio?        @relation(fields: [servicioId], references: [id])
  categoria       CategoriaCargo
  concepto        String
  cantidad        Int
  // ⚖️ Valor final tal como lo cobra el punto de venta (impuestos incluidos).
  valorUnitario   Decimal          @map("valor_unitario") @db.Decimal(10, 2)
  total           Decimal          @db.Decimal(10, 2)
  fecha           DateTime         @default(now())
  usuarioId       String           @map("usuario_id")
  usuario         Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  anulado         Boolean          @default(false)
  motivoAnulacion String?          @map("motivo_anulacion")
  // S-2: la cita o el cupo que lo originó.
  cita            CitaServicio?
  cupo            CupoExperiencia?

  @@index([reservaId])
  @@map("cargo")
}

// Auditoría (R34): qué le pasó a cada reserva, quién lo hizo y cuándo.
// Se escribe en la misma transacción que el cambio de estado.
model EventoReserva {
  id        String            @id @default(uuid())
  reservaId String            @map("reserva_id")
  reserva   Reserva           @relation(fields: [reservaId], references: [id])
  tipo      TipoEventoReserva
  // null = acción automática del sistema (p. ej. detección de no-shows).
  // Restrict: un usuario con acciones registradas no se puede borrar (se
  // desactiva), para que la auditoría nunca pierda quién hizo qué.
  usuarioId String?           @map("usuario_id")
  usuario   Usuario?          @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  fecha     DateTime          @default(now())
  detalle   String?
  // A-5: datos estructurados del evento (en una modificación, el antes, el
  // después y el desglose que se reemplazó).
  datos     Json?

  @@index([reservaId])
  @@map("evento_reserva")
}

// R12: el precio y la capacidad se definen por tipo de habitación; cambiar la
// tarifa de "todas las dobles" es una sola edición.
model TipoHabitacion {
  id                    String       @id @default(uuid())
  hotelId               String       @map("hotel_id")
  hotel                 Hotel        @relation(fields: [hotelId], references: [id])
  codigo                String
  nombre                String
  // Tarifa por noche en temporada baja; las otras temporadas la multiplican.
  tarifaBase            Decimal      @map("tarifa_base") @db.Decimal(10, 2)
  capacidadIncluida     Int          @map("capacidad_incluida")
  capacidadMaxima       Int          @map("capacidad_maxima")
  cargoPersonaAdicional Decimal      @map("cargo_persona_adicional") @db.Decimal(10, 2)
  // A-3: por cada niño con cargo y por noche (los niños gratis no pagan).
  cargoNinoAdicional    Decimal      @map("cargo_nino_adicional") @db.Decimal(10, 2)
  habitaciones          Habitacion[]

  @@unique([hotelId, codigo])
  @@map("tipo_habitacion")
}

model Habitacion {
  id               String           @id @default(uuid())
  hotelId          String           @map("hotel_id")
  hotel            Hotel            @relation(fields: [hotelId], references: [id])
  numero           String
  tipoHabitacionId String           @map("tipo_habitacion_id")
  tipoHabitacion   TipoHabitacion   @relation(fields: [tipoHabitacionId], references: [id])
  estado           EstadoHabitacion @default(libre)
  // A-4: para seleccionar "las del piso N"; se infiere del número si no se da.
  piso             Int?
  descripcion      String?
  reservas         Reserva[]
  tareasLimpieza   TareaLimpieza[]
  incidencias      Incidencia[]

  // Dos hoteles pueden tener cada uno su habitación 101.
  @@unique([hotelId, numero])
  @@map("habitacion")
}

enum TipoDocumento {
  CC // cédula de ciudadanía
  CE // cédula de extranjería
  PASAPORTE
  TI // tarjeta de identidad (menores de 7 a 17 años)
  PPT // permiso por protección temporal
  RC // registro civil (menores de 7 años)
  PEP // permiso especial de permanencia
}

// R44: relación del menor con el adulto responsable que lo acompaña.
enum Parentesco {
  padre_madre
  familiar
  tutor_legal
  tercero_autorizado
}

// Un huésped se identifica por su documento dentro de cada hotel: si vuelve,
// se reutiliza su registro y se conserva su historial de estadías. Los hoteles
// no comparten clientes entre sí.
model Huesped {
  id               String            @id @default(uuid())
  hotelId          String            @map("hotel_id")
  hotel            Hotel             @relation(fields: [hotelId], references: [id])
  // Nombre completo, calculado al guardar a partir de las partes (lo usan
  // las búsquedas y las pantallas).
  nombre           String
  primerNombre     String            @map("primer_nombre")
  segundoNombre    String?           @map("segundo_nombre")
  // '' = por completar (huéspedes anteriores a los nombres separados).
  primerApellido   String            @default("") @map("primer_apellido")
  segundoApellido  String?           @map("segundo_apellido")
  tipoDocumento    TipoDocumento     @default(CC) @map("tipo_documento")
  documento        String
  telefono         String?
  email            String?
  fechaNacimiento  DateTime?         @map("fecha_nacimiento") @db.Date
  // R19: código ISO 3166-1 alfa-2 (CO, VE, US...). Se registra en el check-in.
  nacionalidad     String?
  paisResidencia   String?           @map("pais_residencia")
  ciudadResidencia String?           @map("ciudad_residencia")
  // R43: tiene todos los datos que exige el registro legal.
  datosCompletos   Boolean           @default(false) @map("datos_completos")
  reservas         Reserva[]
  ocupaciones      Ocupante[]
  aceptaciones     AceptacionDatos[]
  citas            CitaServicio[]
  cupos            CupoExperiencia[]

  @@unique([hotelId, tipoDocumento, documento])
  @@map("huesped")
}

model Reserva {
  id                       String            @id @default(uuid())
  // Se repite el hotel de la habitación para filtrar directo por él.
  hotelId                  String            @map("hotel_id")
  hotel                    Hotel             @relation(fields: [hotelId], references: [id])
  habitacionId             String            @map("habitacion_id")
  habitacion               Habitacion        @relation(fields: [habitacionId], references: [id])
  huespedId                String            @map("huesped_id")
  huesped                  Huesped           @relation(fields: [huespedId], references: [id])
  fechaEntrada             DateTime          @map("fecha_entrada") @db.Date
  fechaSalida              DateTime          @map("fecha_salida") @db.Date
  estado                   EstadoReserva     @default(confirmada)
  // A-3: quienes pagan como adultos y la edad declarada de cada niño (la
  // capacidad cuenta a todos). El total de huéspedes se calcula.
  adultos                  Int               @default(1)
  edadesNinos              Int[]             @default([]) @map("edades_ninos")
  // Precio total pactado al confirmar (R5): no cambia aunque el hotel
  // modifique sus tarifas después. Incluye adicionales e IVA.
  valorAlojamiento         Decimal           @map("valor_alojamiento") @db.Decimal(10, 2)
  // Desglose congelado noche por noche (ver tarifas/motor-tarificacion.ts).
  // null en reservas anteriores al motor de tarifas.
  desglose                 Json?
  // R5/R9: la política de cancelación del hotel al reservar queda pactada,
  // igual que el precio: si el hotel la cambia, esta reserva no se afecta.
  // null en reservas anteriores (usan la política vigente).
  cancelacionGratuitaHasta DateTime?         @map("cancelacion_gratuita_hasta")
  nochesPenalidad          Int?              @map("noches_penalidad")
  // A-2: anticipo sugerido al reservar (porcentaje del hotel × total, al peso).
  // Queda pactado como la cancelación (R40). null en reservas anteriores.
  anticipoSugerido         Decimal?          @map("anticipo_sugerido") @db.Decimal(10, 2)
  // Monto liquidado al terminar: el alojamiento en el check-out, o la
  // penalidad en una cancelación tardía / no-show (0 si no aplica).
  total                    Decimal?          @db.Decimal(10, 2)
  // R19: motivo del viaje entero, tomado en el check-in. La procedencia es
  // de cada ocupante.
  motivoViaje              MotivoViaje?      @map("motivo_viaje")
  createdAt                DateTime          @default(now()) @map("created_at")
  eventos                  EventoReserva[]
  cargos                   Cargo[]
  ocupantes                Ocupante[]
  pagos                    Pago[]
  citas                    CitaServicio[]
  cupos                    CupoExperiencia[]
  intentosPago             IntentoPago[]

  @@index([hotelId, estado])
  @@map("reserva")
}

// R43: cada persona que se aloja en la reserva (el titular y sus acompañantes).
// Lo de la persona va en Huesped; lo de esta estadía, aquí: quien vuelve no
// repite sus datos, pero su procedencia puede cambiar en cada viaje.
// Un solo titular por reserva: índice parcial único ocupante_un_titular,
// escrito a mano en la migración ocupantes_y_datos_legales (Prisma no lo modela).
model Ocupante {
  id                          String      @id @default(uuid())
  hotelId                     String      @map("hotel_id")
  hotel                       Hotel       @relation(fields: [hotelId], references: [id])
  reservaId                   String      @map("reserva_id")
  reserva                     Reserva     @relation(fields: [reservaId], references: [id])
  huespedId                   String      @map("huesped_id")
  huesped                     Huesped     @relation(fields: [huespedId], references: [id])
  titular                     Boolean     @default(false)
  paisProcedencia             String?     @map("pais_procedencia")
  ciudadProcedencia           String?     @map("ciudad_procedencia")
  // R44: solo para menores: su parentesco con el adulto responsable.
  parentesco                  Parentesco?
  responsableId               String?     @map("responsable_id")
  responsable                 Ocupante?   @relation("ResponsableDeMenor", fields: [responsableId], references: [id])
  menoresACargo               Ocupante[]  @relation("ResponsableDeMenor")
  // R44: quién revisó el permiso de los padres (familiar o tercero autorizado).
  autorizacionVerificadaPorId String?     @map("autorizacion_verificada_por_id")
  autorizacionVerificadaPor   Usuario?    @relation(fields: [autorizacionVerificadaPorId], references: [id], onDelete: Restrict)
  createdAt                   DateTime    @default(now()) @map("created_at")

  @@unique([reservaId, huespedId])
  @@index([hotelId])
  @@map("ocupante")
}

// R45 (Ley 1581): política de tratamiento de datos del hotel. No se edita:
// cada cambio crea una versión, para saber qué texto aceptó cada huésped.
model PoliticaDatos {
  id           String            @id @default(uuid())
  hotelId      String            @map("hotel_id")
  hotel        Hotel             @relation(fields: [hotelId], references: [id])
  version      Int
  texto        String
  vigenteDesde DateTime          @default(now()) @map("vigente_desde")
  aceptaciones AceptacionDatos[]

  @@unique([hotelId, version])
  @@map("politica_datos")
}

// R45: quién aceptó qué versión de la política, cuándo y ante qué usuario.
model AceptacionDatos {
  id         String        @id @default(uuid())
  huespedId  String        @map("huesped_id")
  huesped    Huesped       @relation(fields: [huespedId], references: [id])
  politicaId String        @map("politica_id")
  politica   PoliticaDatos @relation(fields: [politicaId], references: [id])
  fecha      DateTime      @default(now())
  usuarioId  String        @map("usuario_id")
  usuario    Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@unique([huespedId, politicaId])
  @@map("aceptacion_datos")
}

// A-1: libro de pagos del folio. El saldo nunca se guarda: se calcula de aquí
// (ver folio/estado-de-cuenta.ts). Un pago no se borra: se anula, con motivo.
// El monto es siempre positivo (CHECK pago_monto_positivo en la migración).
model Pago {
  id              String           @id @default(uuid())
  hotelId         String           @map("hotel_id")
  hotel           Hotel            @relation(fields: [hotelId], references: [id])
  // S-2: un pago es de una reserva, de una cita o de un cupo (CHECK en la
  // migración: exactamente uno). Los de la cita o el cupo son de quien no
  // tiene una estadía activa a la cual cargarlo.
  reservaId       String?          @map("reserva_id")
  reserva         Reserva?         @relation(fields: [reservaId], references: [id], onDelete: Restrict)
  citaId          String?          @map("cita_id")
  cita            CitaServicio?    @relation(fields: [citaId], references: [id], onDelete: Restrict)
  cupoId          String?          @map("cupo_id")
  cupo            CupoExperiencia? @relation(fields: [cupoId], references: [id], onDelete: Restrict)
  tipo            TipoPago
  medio           MedioPago
  monto           Decimal          @db.Decimal(10, 2)
  // Número del voucher o de la transferencia.
  referencia      String?
  fecha           DateTime         @default(now())
  // null = lo registró el sistema (p. ej. la migración de los cobros antiguos).
  usuarioId       String?          @map("usuario_id")
  usuario         Usuario?         @relation("PagoRegistradoPor", fields: [usuarioId], references: [id], onDelete: Restrict)
  anulado         Boolean          @default(false)
  motivoAnulacion String?          @map("motivo_anulacion")
  // B-3: cuándo y en qué turno se anuló (la anulación es un ajuste de ese turno).
  anuladoEn       DateTime?        @map("anulado_en")
  anuladoTurnoId  String?          @map("anulado_turno_id")
  anuladoTurno    Turno?           @relation("PagoAnuladoEnTurno", fields: [anuladoTurnoId], references: [id], onDelete: Restrict)
  // B-3: el turno abierto de quien lo registró (null = sin turno).
  turnoId         String?          @map("turno_id")
  turno           Turno?           @relation("PagoDelTurno", fields: [turnoId], references: [id], onDelete: Restrict)
  anuladoPorId    String?          @map("anulado_por_id")
  anuladoPor      Usuario?         @relation("PagoAnuladoPor", fields: [anuladoPorId], references: [id], onDelete: Restrict)
  // B-2: el intento de pago en línea que lo originó (si vino de la pasarela).
  intento         IntentoPago?

  @@index([reservaId])
  @@index([hotelId, fecha])
  @@map("pago")
}

// S-2: agenda de los servicios. Estados de una cita: agendada → en_curso →
// realizada, o cancelada / no_asistio. Nada se borra.
enum EstadoCita {
  agendada
  en_curso
  realizada
  cancelada
  no_asistio
}

enum EstadoSalida {
  programada
  realizada
  cancelada
}

enum EstadoCupo {
  vigente
  cancelado
}

// S-2: quien presta una cita (una cabina, un terapeuta).
model RecursoServicio {
  id        String              @id @default(uuid())
  hotelId   String              @map("hotel_id")
  hotel     Hotel               @relation(fields: [hotelId], references: [id])
  nombre    String
  activo    Boolean             @default(true)
  createdAt DateTime            @default(now()) @map("created_at")
  servicios RecursoDeServicio[]
  citas     CitaServicio[]

  @@unique([hotelId, nombre])
  @@map("recurso_servicio")
}

// Qué servicios de tipo cita presta cada recurso.
model RecursoDeServicio {
  recursoId  String          @map("recurso_id")
  recurso    RecursoServicio @relation(fields: [recursoId], references: [id])
  servicioId String          @map("servicio_id")
  servicio   Servicio        @relation(fields: [servicioId], references: [id])

  @@id([recursoId, servicioId])
  @@map("recurso_de_servicio")
}

// S-2: una cita de un recurso. La restricción cita_sin_cruce (en la migración)
// impide dos citas vigentes del mismo recurso con [inicio, fin_ocupado)
// cruzados: es la misma garantía que la no-sobreventa de las habitaciones.
model CitaServicio {
  id          String          @id @default(uuid())
  hotelId     String          @map("hotel_id")
  hotel       Hotel           @relation(fields: [hotelId], references: [id])
  servicioId  String          @map("servicio_id")
  servicio    Servicio        @relation(fields: [servicioId], references: [id])
  recursoId   String          @map("recurso_id")
  recurso     RecursoServicio @relation(fields: [recursoId], references: [id])
  // null = huésped externo (sin reserva en el hotel).
  reservaId   String?         @map("reserva_id")
  reserva     Reserva?        @relation(fields: [reservaId], references: [id])
  huespedId   String          @map("huesped_id")
  huesped     Huesped         @relation(fields: [huespedId], references: [id])
  inicio      DateTime
  // Fin del servicio y fin del recurso ocupado (más el margen de limpieza).
  fin         DateTime
  finOcupado  DateTime        @map("fin_ocupado")
  // Quiénes lo toman (R55): fijo/por persona = cantidad; por edad = adultos y edades.
  cantidad    Int             @default(1)
  adultos     Int             @default(0)
  edadesNinos Int[]           @default([]) @map("edades_ninos")
  // Precio congelado al agendar.
  valor       Decimal         @db.Decimal(10, 2)
  concepto    String
  estado      EstadoCita      @default(agendada)
  cargoId     String?         @unique @map("cargo_id")
  cargo       Cargo?          @relation(fields: [cargoId], references: [id])
  usuarioId   String          @map("usuario_id")
  usuario     Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  createdAt   DateTime        @default(now()) @map("created_at")
  pagos       Pago[]

  @@index([hotelId, inicio])
  @@index([reservaId])
  @@map("cita_servicio")
}

// S-2: una salida de una experiencia, con N cupos.
model SalidaExperiencia {
  id         String            @id @default(uuid())
  hotelId    String            @map("hotel_id")
  hotel      Hotel             @relation(fields: [hotelId], references: [id])
  servicioId String            @map("servicio_id")
  servicio   Servicio          @relation(fields: [servicioId], references: [id])
  inicio     DateTime
  cupos      Int
  estado     EstadoSalida      @default(programada)
  createdAt  DateTime          @default(now()) @map("created_at")
  tomados    CupoExperiencia[]

  @@index([hotelId, inicio])
  @@map("salida_experiencia")
}

// S-2: personas de una reserva o de un huésped externo en una salida. Que la
// suma no pase de los cupos lo protege el bloqueo de la salida (FOR UPDATE).
model CupoExperiencia {
  id          String            @id @default(uuid())
  // Se repite el hotel de la salida para filtrar directo por él.
  hotelId     String            @map("hotel_id")
  hotel       Hotel             @relation(fields: [hotelId], references: [id])
  salidaId    String            @map("salida_id")
  salida      SalidaExperiencia @relation(fields: [salidaId], references: [id])
  reservaId   String?           @map("reserva_id")
  reserva     Reserva?          @relation(fields: [reservaId], references: [id])
  huespedId   String            @map("huesped_id")
  huesped     Huesped           @relation(fields: [huespedId], references: [id])
  personas    Int
  adultos     Int               @default(0)
  edadesNinos Int[]             @default([]) @map("edades_ninos")
  valor       Decimal           @db.Decimal(10, 2)
  concepto    String
  estado      EstadoCupo        @default(vigente)
  cargoId     String?           @unique @map("cargo_id")
  cargo       Cargo?            @relation(fields: [cargoId], references: [id])
  usuarioId   String            @map("usuario_id")
  usuario     Usuario           @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  createdAt   DateTime          @default(now()) @map("created_at")
  pagos       Pago[]

  @@index([salidaId])
  @@index([reservaId])
  @@map("cupo_experiencia")
}

// B-3: turno de caja de un usuario. Como máximo uno abierto por usuario: lo
// garantiza la restricción turno_uno_abierto_por_usuario (en la migración).
// Al cerrar se congela el resumen: una anulación posterior no lo cambia.
model Turno {
  id              String    @id @default(uuid())
  hotelId         String    @map("hotel_id")
  hotel           Hotel     @relation(fields: [hotelId], references: [id])
  usuarioId       String    @map("usuario_id")
  usuario         Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  abiertoEn       DateTime  @map("abierto_en")
  cerradoEn       DateTime? @map("cerrado_en")
  // El efectivo con el que se empieza.
  baseEfectivo    Decimal   @map("base_efectivo") @db.Decimal(12, 2)
  efectivoContado Decimal?  @map("efectivo_contado") @db.Decimal(12, 2)
  observaciones   String?
  resumenCierre   Json?     @map("resumen_cierre")
  pagos           Pago[]    @relation("PagoDelTurno")
  anulaciones     Pago[]    @relation("PagoAnuladoEnTurno")

  @@index([hotelId, abiertoEn])
  @@map("turno")
}

// B-2: pagos en línea. Un intento es un link de pago enviado al huésped; el
// Pago solo existe cuando la pasarela lo confirma (R29). La referencia es
// nuestra (el monto lo fija el servidor) y el id de la transacción del
// proveedor es único: el mismo evento dos veces no crea dos pagos.
enum EstadoIntentoPago {
  creado
  aprobado
  rechazado
  expirado
}

enum ProveedorPasarela {
  simulada
  wompi
}

model IntentoPago {
  id                     String            @id @default(uuid())
  hotelId                String            @map("hotel_id")
  hotel                  Hotel             @relation(fields: [hotelId], references: [id])
  reservaId              String            @map("reserva_id")
  reserva                Reserva           @relation(fields: [reservaId], references: [id], onDelete: Restrict)
  referencia             String            @unique
  monto                  Decimal           @db.Decimal(10, 2)
  proveedor              ProveedorPasarela
  estado                 EstadoIntentoPago @default(creado)
  url                    String
  expiraEn               DateTime          @map("expira_en")
  idTransaccionProveedor String?           @unique @map("id_transaccion_proveedor")
  pagoId                 String?           @unique @map("pago_id")
  pago                   Pago?             @relation(fields: [pagoId], references: [id], onDelete: Restrict)
  // Un evento que no cuadra (p. ej. otro monto): no se registra y queda aquí.
  alerta                 String?
  usuarioId              String?           @map("usuario_id")
  usuario                Usuario?          @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  creadoEn               DateTime          @map("creado_en")

  @@index([hotelId, estado])
  @@index([reservaId])
  @@map("intento_pago")
}

// B-2: la cuenta de Wompi de cada hotel. Las llaves se guardan cifradas
// (AES-256-GCM con CLAVE_CIFRADO_PAGOS) y nunca salen por la API.
model ConfiguracionPasarela {
  id                String   @id @default(uuid())
  hotelId           String   @unique @map("hotel_id")
  hotel             Hotel    @relation(fields: [hotelId], references: [id])
  // pruebas | produccion, según el prefijo de la llave pública.
  ambiente          String
  llavePublica      String   @map("llave_publica")
  llavePrivada      String   @map("llave_privada")
  secretoEventos    String   @map("secreto_eventos")
  secretoIntegridad String   @map("secreto_integridad")
  actualizadoEn     DateTime @map("actualizado_en")

  @@map("configuracion_pasarela")
}

// B-4: limpieza. salida: después del check-out (libera la habitación al
// terminar); repaso: una habitación ocupada; profunda: limpieza a fondo.
enum TipoTareaLimpieza {
  salida
  repaso
  profunda
}

enum EstadoTareaLimpieza {
  pendiente
  en_proceso
  terminada
}

// Una tarea por habitación, día y tipo: el índice único evita los duplicados
// aunque el check-out o el cron de los repasos corran dos veces.
model TareaLimpieza {
  id            String              @id @default(uuid())
  hotelId       String              @map("hotel_id")
  hotel         Hotel               @relation(fields: [hotelId], references: [id])
  habitacionId  String              @map("habitacion_id")
  habitacion    Habitacion          @relation(fields: [habitacionId], references: [id], onDelete: Restrict)
  fecha         DateTime            @db.Date
  tipo          TipoTareaLimpieza
  asignadaAId   String?             @map("asignada_a_id")
  asignadaA     Usuario?            @relation(fields: [asignadaAId], references: [id], onDelete: Restrict)
  estado        EstadoTareaLimpieza @default(pendiente)
  inicio        DateTime?
  fin           DateTime?
  observaciones String?
  creadaEn      DateTime            @map("creada_en")

  @@unique([habitacionId, fecha, tipo])
  @@index([hotelId, fecha])
  @@map("tarea_limpieza")
}

enum PrioridadIncidencia {
  baja
  media
  alta
}

enum EstadoIncidencia {
  abierta
  resuelta
}

// B-4: un daño reportado por alguien del hotel. Si saca de servicio, la
// habitación queda fuera_servicio; resolverla no la devuelve sola a libre.
model Incidencia {
  id             String              @id @default(uuid())
  hotelId        String              @map("hotel_id")
  hotel          Hotel               @relation(fields: [hotelId], references: [id])
  habitacionId   String              @map("habitacion_id")
  habitacion     Habitacion          @relation(fields: [habitacionId], references: [id], onDelete: Restrict)
  descripcion    String
  prioridad      PrioridadIncidencia
  sacaDeServicio Boolean             @map("saca_de_servicio")
  estado         EstadoIncidencia    @default(abierta)
  reportadaPorId String              @map("reportada_por_id")
  reportadaPor   Usuario             @relation("IncidenciaReportadaPor", fields: [reportadaPorId], references: [id], onDelete: Restrict)
  creadaEn       DateTime            @map("creada_en")
  resueltaPorId  String?             @map("resuelta_por_id")
  resueltaPor    Usuario?            @relation("IncidenciaResueltaPor", fields: [resueltaPorId], references: [id], onDelete: Restrict)
  resueltaEn     DateTime?           @map("resuelta_en")
  solucion       String?

  @@index([hotelId, estado])
  @@map("incidencia")
}
