DATABASE_URL="postgresql://hotel:hotel@localhost:5432/mvp_hotel?schema=public"
PORT=3000

# Firma de los tokens de sesión. En producción: un valor largo y aleatorio.
JWT_SECRET=cambia-este-valor-por-uno-largo-y-aleatorio

# Usuarios iniciales que crea "npm run seed" si no existen (solo desarrollo/demo).
# Cambia estas contraseñas desde la app después del primer ingreso.
ADMIN_EMAIL=admin@hotel.local
ADMIN_PASSWORD=Admin-dev-2026
RECEPCION_EMAIL=recepcion@hotel.local
RECEPCION_PASSWORD=Recepcion-dev-2026
# Equipo de Lazaro (Consola Lazaro): crea hoteles y da acceso a su personal.
PLATAFORMA_EMAIL=consola@lazaro.local
PLATAFORMA_PASSWORD=Consola-Lazaro-2026
# Segundo hotel de la demo (Sol Caribe): su administrador y su recepcionista.
SOL_ADMIN_EMAIL=admin@solcaribe.local
SOL_ADMIN_PASSWORD=SolCaribe-2026
SOL_RECEPCION_EMAIL=recepcion@solcaribe.local
SOL_RECEPCION_PASSWORD=SolCaribe-2026
# Frontends autorizados a llamar a la API desde el navegador (separados por coma).
CORS_ORIGENES=http://localhost:5173

# Intentos de inicio de sesión permitidos por minuto y por IP.
LOGIN_INTENTOS_POR_MINUTO=5

# B-2: pagos en línea. simulada (demo y pruebas, sin llaves) o wompi. En
# producción la simulada está prohibida: el backend no arranca.
PASARELA_PROVEEDOR=simulada
# Llave maestra con la que se cifran las llaves de Wompi de cada hotel (32 bytes
# en base64). Genérala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CLAVE_CIFRADO_PAGOS=
# URL pública del backend (para la URL de eventos de Wompi; con un túnel en local).
URL_PUBLICA_API=http://localhost:3000
# URL pública del frontend (página de retorno y página de pago simulada).
URL_PUBLICA_APP=http://localhost:5173
